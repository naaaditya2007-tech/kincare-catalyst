# KinCare Environment Configuration

# Optional: Resend API Key for live transactional email delivery
# If absent or invalid, KinCare automatically falls back to formatted simulated delivery
# while still recording full logs in the Email Dispatch Audit Trail.
RESEND_API_KEY=re_your_api_key_here

# Optional: Verified sender email address in Resend (default: onboarding@resend.dev)
RESEND_FROM_EMAIL=KinCare Alert <onboarding@resend.dev>

# Optional: Port configuration (default 3000)
PORT=3000
